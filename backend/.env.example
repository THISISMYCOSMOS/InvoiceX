# Settings are read from BOTH ../.env (repository root) and backend/.env, in that
# order, and the two are MERGED. backend/.env wins on any key defined in both --
# including keys defined as empty here, which then shadow a real value in the root
# .env and silently downgrade the demo to mock mode. Keep the configuration in ONE
# of the two files; do not maintain both.

PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIRECTORY=uploads
MAX_DOCUMENT_SIZE_BYTES=20971520
RWA_DATABASE_PATH=invoicex-devnet.sqlite3

# Cloud Run production uses the GCP target below. Keep database passwords and
# AUTH_TOKEN_SECRET in Secret Manager, never in this file or Vite variables.
# DEPLOYMENT_TARGET=gcp
# PERSISTENCE_BACKEND=cloud_sql
# DOCUMENT_STORAGE_BACKEND=gcs
# API_AUTH_REQUIRED=true
# GCP_PROJECT_ID=your-project-id
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-project-id:asia-northeast3:invoicex
# CLOUD_SQL_DATABASE=invoicex
# CLOUD_SQL_USER=invoicex_app
# CLOUD_SQL_IP_TYPE=public
# GCS_DOCUMENT_BUCKET=your-project-id-invoicex-documents
# GCS_DOCUMENT_PREFIX=invoices
# GCS_SIGNED_URL_TTL_SECONDS=900
# Cloud Run uses this non-secret service account identity with IAM signBlob;
# no service account key file is required.
# GCS_SIGNING_SERVICE_ACCOUNT=invoicex-api@your-project-id.iam.gserviceaccount.com

# GCP Secret Manager overlay. These values are not secret; disabled by default so
# plain local .env configuration keeps working.
SECRET_MANAGER_ENABLED=false
GCP_PROJECT_ID=
SECRET_NAME_PREFIX=

# Both modes default to auto, so leave them commented out: defining an empty or
# auto value here could shadow an explicit production value in the root .env.
# AGENT_MODE=auto
# SOLANA_MODE=auto

# Gemini is invoked only by the backend process. AGENT_MODE=real requires this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=2

# Solana Devnet defaults. Keep all private keys and Privy credentials out of git
# and out of Vite variables; Cloud Run should use Secret Manager for them.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CAIP2=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_USDC_DECIMALS=6
SOLANA_CONFIRMATION_TIMEOUT_SECONDS=30
SOLANA_DEMO_TRANSFER_AMOUNT_USDC=1
SOLANA_PLATFORM_KEYPAIR=
SOLANA_AGENT_VAULT_KEYPAIR=
DEMO_STABLECOIN_MINT=

# Public identifier for the shared InvoiceX Privy development app.
PRIVY_APP_ID=cms678zqw007k0cjkq4jhxn9q
PRIVY_APP_SECRET=
# Privy access-token verification. Configure either the public key or JWKS URL.
PRIVY_VERIFICATION_KEY=
PRIVY_JWKS_URL=
PRIVY_API_TIMEOUT_SECONDS=15
PRIVY_OTP_DISPLAY_TTL_SECONDS=300
# Treasury / Agent Vault service wallet. PRIVY_WALLET_ID remains a legacy alias.
PRIVY_TREASURY_WALLET_ID=
PRIVY_TREASURY_WALLET_ADDRESS=
PRIVY_RWA_ISSUER_WALLET_ID=
PRIVY_SETTLEMENT_WALLET_ID=
# Privy's own gas-sponsorship product. Keep false when using the dedicated
# Sponsor wallet below as the Devnet transaction fee payer.
PRIVY_SPONSOR=false
# Use rpc locally so Privy signs with service-wallet keys and the configured
# Devnet RPC broadcasts the same recent blockhash. Set privy only when using
# Privy's managed broadcaster.
PRIVY_BROADCAST_MODE=rpc
GASLESS_ENABLED=true
PRIVY_SPONSOR_WALLET_ID=
PRIVY_SPONSOR_WALLET_ADDRESS=

# Public wallet addresses, not secrets.
SUPPLIER_WALLET_ADDRESS=
INVESTOR_SETTLEMENT_WALLET_ADDRESS=
PLATFORM_FEE_WALLET_ADDRESS=
DEMO_KRW_PER_USDC=1000
