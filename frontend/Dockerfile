FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_API_BASE_URL
ARG VITE_USE_MOCK_API=false
ARG VITE_PRIVY_APP_ID
ARG VITE_SOLANA_RPC_URL
ARG VITE_SOLANA_USDC_MINT
ARG VITE_SOLANA_USDC_DECIMALS=6
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_USE_MOCK_API=${VITE_USE_MOCK_API}
ENV VITE_PRIVY_APP_ID=${VITE_PRIVY_APP_ID}
ENV VITE_SOLANA_RPC_URL=${VITE_SOLANA_RPC_URL}
ENV VITE_SOLANA_USDC_MINT=${VITE_SOLANA_USDC_MINT}
ENV VITE_SOLANA_USDC_DECIMALS=${VITE_SOLANA_USDC_DECIMALS}

RUN npm run build

FROM nginx:1.27-alpine

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
