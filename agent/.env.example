# Copy this file to .env and set the key locally. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=1

# Optional free local OCR. If unavailable, image-only evidence remains review-required.
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_LANGUAGES=kor+eng
OCR_TIMEOUT_SECONDS=30
OCR_MIN_CONFIDENCE=70
