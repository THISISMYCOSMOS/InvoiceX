# InvoiceX API server — local Privy Devnet configuration.
# Copy to backend/.env. Never commit backend/.env or put its secrets in the frontend.

PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIRECTORY=uploads
MAX_DOCUMENT_SIZE_BYTES=20971520
RWA_DATABASE_PATH=invoicex-devnet.sqlite3

# Gemini is invoked by this backend process. AGENT_MODE=real requires this key.
AGENT_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=2

# Use explicit Privy mode for a real Devnet run. Do not use auto for a demo that
# must fail visibly when Privy configuration is incomplete.
SOLANA_MODE=privy
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CAIP2=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_USDC_DECIMALS=6
SOLANA_CONFIRMATION_TIMEOUT_SECONDS=30

# Privy server credentials and service wallets. Store PRIVY_APP_SECRET in
# Secret Manager for Cloud Run; do not put it in Git or Vite variables.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_TREASURY_WALLET_ID=
PRIVY_TREASURY_WALLET_ADDRESS=
PRIVY_RWA_ISSUER_WALLET_ID=
PRIVY_SPONSOR=true
GASLESS_ENABLED=true
PRIVY_SPONSOR_WALLET_ID=
PRIVY_SPONSOR_WALLET_ADDRESS=
GASLESS_DEPOSIT_MAX_USDC=1

# External supplier wallet that receives USDC after an approved automatic purchase.
SUPPLIER_WALLET_ADDRESS=

# Investor policy limits. The investor external wallet is connected and signed
# in the browser, so it is not configured as a server-side secret here.
MANDATE_MIN_RISK_SCORE=80
MANDATE_MAX_ADVANCE_USDC=25000
