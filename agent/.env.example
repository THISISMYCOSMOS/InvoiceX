# Standalone Agent CLI only. The FastAPI application reads Gemini settings from
# backend/.env and passes them to this package, so do not create agent/.env for
# a normal full-stack run. Never commit a local .env file.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_ATTEMPTS=2

# Optional free local OCR. If unavailable, image-only evidence remains review-required.
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_LANGUAGES=kor+eng
OCR_TIMEOUT_SECONDS=30
OCR_MIN_CONFIDENCE=70
