# Settings are read from BOTH ../.env (repository root) and backend/.env, in that
# order, and the two are MERGED. backend/.env wins on any key defined in both --
# including keys defined as empty here, which then shadow a real value in the root
# .env and silently downgrade the demo to mock mode. Keep the configuration in ONE
# of the two files; do not maintain both.
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
# GCP Secret Manager overlay. Not a secret itself; disabled by default so plain .env keeps working.
SECRET_MANAGER_ENABLED=false
GCP_PROJECT_ID=
SECRET_NAME_PREFIX=
# Both default to auto, so they are left commented out on purpose: an uncommented
# auto here would shadow an explicit AGENT_MODE=real / SOLANA_MODE=privy in the root
# .env and turn a missing-credential startup failure into a silent mock run.
# AGENT_MODE=auto
# SOLANA_MODE=auto
# SOLANA_MODE=auto selects Privy when all required Privy values are set.
# Direct mode is retained for isolated local tests only.
# Keep these base58 secrets out of git and never expose them to the frontend.
SOLANA_PLATFORM_KEYPAIR=
SOLANA_AGENT_VAULT_KEYPAIR=
DEMO_STABLECOIN_MINT=
RWA_DATABASE_PATH=invoicex-devnet.sqlite3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=1

PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Treasury / Agent Vault service wallet. PRIVY_WALLET_ID remains a legacy alias.
PRIVY_TREASURY_WALLET_ID=
PRIVY_RWA_ISSUER_WALLET_ID=
PRIVY_SETTLEMENT_WALLET_ID=
PRIVY_SPONSOR=true
# Optional gasless external-wallet Vault deposits. The Sponsor wallet holds Devnet SOL only.
GASLESS_ENABLED=false
PRIVY_SPONSOR_WALLET_ID=
PRIVY_SPONSOR_WALLET_ADDRESS=
GASLESS_DEPOSIT_MAX_USDC=1

SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CAIP2=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_USDC_DECIMALS=6
SOLANA_CONFIRMATION_TIMEOUT_SECONDS=30
SOLANA_DEMO_TRANSFER_AMOUNT_USDC=1

SUPPLIER_WALLET_ADDRESS=
INVESTOR_SETTLEMENT_WALLET_ADDRESS=
# Preferred explicit name for the same public Treasury / Agent Vault address.
PRIVY_TREASURY_WALLET_ADDRESS=
PLATFORM_FEE_WALLET_ADDRESS=
DEMO_KRW_PER_USDC=1000
